# better-sqlite3 ships prebuilt binaries (prebuilds/<platform>-<arch>.node) and loads them first,
# but npm still runs its implicit `node-gyp rebuild`, which needs a C++ toolchain. No other
# dependency needs install scripts, so they are disabled. `npm run` / `npm test` are unaffected.
# See specs/001-registro-movimientos/research.md (R10).
ignore-scripts=true
engine-strict=true
